<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.quartz.Compositor.WindowBridge">
    <method name="ListWindows">
      <arg name="windowsJson" type="s" direction="out"/>
    </method>
    <method name="ActivateWindow">
      <arg name="id" type="s" direction="in"/>
    </method>
    <method name="CloseWindow">
      <arg name="id" type="s" direction="in"/>
    </method>
    <method name="MinimizeWindow">
      <arg name="id" type="s" direction="in"/>
    </method>
    <method name="RestoreWindow">
      <arg name="id" type="s" direction="in"/>
    </method>
    <method name="ActivateApp">
      <arg name="appId" type="s" direction="in"/>
    </method>
    <method name="SetMinimizedGeometry">
      <arg name="id" type="s" direction="in"/>
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
      <arg name="w" type="i" direction="in"/>
      <arg name="h" type="i" direction="in"/>
    </method>
    <signal name="WindowAdded">
      <arg name="windowJson" type="s"/>
    </signal>
    <signal name="WindowRemoved">
      <arg name="id" type="s"/>
    </signal>
    <signal name="WindowChanged">
      <arg name="windowJson" type="s"/>
    </signal>
    <signal name="ActiveWindowChanged">
      <arg name="id" type="s"/>
      <arg name="appId" type="s"/>
      <arg name="title" type="s"/>
    </signal>
  </interface>
</node>

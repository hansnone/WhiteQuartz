<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.quartz.Compositor.StageManager">
    <method name="SetEnabled">
      <arg name="enabled" type="b" direction="in"/>
    </method>
    <method name="Toggle"/>
    <method name="ToggleMissionControl"/>
    <method name="ToggleAppExpose"/>
    <method name="ActivateStageGroup">
      <arg name="groupIndex" type="i" direction="in"/>
    </method>
    <property name="Enabled" type="b" access="read"/>
    <property name="SpatialMode" type="i" access="read"/>
    <signal name="SpatialModeChanged">
      <arg name="mode" type="i"/>
    </signal>
  </interface>
</node>

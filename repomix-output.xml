import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15

Window {
    id: ccWindow
    visible: typeof hardwareCtrl !== "undefined" ? hardwareCtrl.visible : false
    width: 320
    height: ccCol.implicitHeight + 24
    color: "transparent"
    flags: Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool

    x: Screen.width - width - 12
    y: 28

    Rectangle {
        anchors.fill: parent
        radius: 18
        color: "#CC1C1C1E" // Frosted glass oscuro
        border.color: "#33FFFFFF"
        border.width: 1

        ColumnLayout {
            id: ccCol
            anchors.fill: parent
            anchors.margins: 12
            spacing: 10

            // Grid 2x2: Wi-Fi, Bluetooth, No Molestar, Stage Manager
            GridLayout {
                Layout.fillWidth: true
                columns: 2
                rowSpacing: 8
                columnSpacing: 8

                // Wi-Fi Card
                Rectangle {
                    Layout.fillWidth: true
                    height: 60
                    radius: 12
                    color: (typeof hardwareCtrl !== "undefined" && hardwareCtrl.wifiEnabled) ? "#007AFF" : "#2C2C2E"

                    MouseArea {
                        anchors.fill: parent
                        onClicked: if (typeof hardwareCtrl !== "undefined") hardwareCtrl.toggleWifi()
                    }

                    RowLayout {
                        anchors.fill: parent
                        anchors.margins: 8
                        spacing: 8

                        Rectangle {
                            width: 32
                            height: 32
                            radius: 16
                            color: "#FFFFFF"
                            Text {
                                anchors.centerIn: parent
                                text: "📶"
                                font.pixelSize: 14
                            }
                        }

                        ColumnLayout {
                            spacing: 2
                            Text {
                                text: qsTr("Wi-Fi")
                                color: "white"
                                font.bold: true
                                font.pixelSize: 12
                            }
                            Text {
                                text: (typeof hardwareCtrl !== "undefined" && hardwareCtrl.wifiEnabled) ? hardwareCtrl.wifiSsid : qsTr("Desactivado")
                                color: "#EBEBF5"
                                font.pixelSize: 10
                            }
                        }
                    }
                }

                // Bluetooth Card
                Rectangle {
                    Layout.fillWidth: true
                    height: 60
                    radius: 12
                    color: (typeof hardwareCtrl !== "undefined" && hardwareCtrl.bluetoothEnabled) ? "#007AFF" : "#2C2C2E"

                    MouseArea {
                        anchors.fill: parent
                        onClicked: if (typeof hardwareCtrl !== "undefined") hardwareCtrl.toggleBluetooth()
                    }

                    RowLayout {
                        anchors.fill: parent
                        anchors.margins: 8
                        spacing: 8

                        Rectangle {
                            width: 32
                            height: 32
                            radius: 16
                            color: "#FFFFFF"
                            Text {
                                anchors.centerIn: parent
                                text: "ᛒ"
                                color: "#007AFF"
                                font.bold: true
                                font.pixelSize: 16
                            }
                        }

                        ColumnLayout {
                            spacing: 2
                            Text {
                                text: qsTr("Bluetooth")
                                color: "white"
                                font.bold: true
                                font.pixelSize: 12
                            }
                            Text {
                                text: (typeof hardwareCtrl !== "undefined" && hardwareCtrl.bluetoothEnabled) ? qsTr("Activado") : qsTr("Desactivado")
                                color: "#EBEBF5"
                                font.pixelSize: 10
                            }
                        }
                    }
                }

                // Concentración / No Molestar Card
                Rectangle {
                    Layout.fillWidth: true
                    height: 60
                    radius: 12
                    color: (typeof hardwareCtrl !== "undefined" && hardwareCtrl.doNotDisturb) ? "#5E5CE6" : "#2C2C2E"

                    MouseArea {
                        anchors.fill: parent
                        onClicked: if (typeof hardwareCtrl !== "undefined") hardwareCtrl.doNotDisturb = !hardwareCtrl.doNotDisturb
                    }

                    RowLayout {
                        anchors.fill: parent
                        anchors.margins: 8
                        spacing: 8

                        Rectangle {
                            width: 32
                            height: 32
                            radius: 16
                            color: "#FFFFFF"
                            Text {
                                anchors.centerIn: parent
                                text: "🌙"
                                font.pixelSize: 14
                            }
                        }

                        ColumnLayout {
                            spacing: 2
                            Text {
                                text: qsTr("Concentración")
                                color: "white"
                                font.bold: true
                                font.pixelSize: 12
                            }
                            Text {
                                text: (typeof hardwareCtrl !== "undefined" && hardwareCtrl.doNotDisturb) ? qsTr("No molestar") : qsTr("Desactivada")
                                color: "#EBEBF5"
                                font.pixelSize: 10
                            }
                        }
                    }
                }

                // Batería Card
                Rectangle {
                    Layout.fillWidth: true
                    height: 60
                    radius: 12
                    color: "#2C2C2E"

                    RowLayout {
                        anchors.fill: parent
                        anchors.margins: 8
                        spacing: 8

                        Rectangle {
                            width: 32
                            height: 32
                            radius: 16
                            color: "#30D158"
                            Text {
                                anchors.centerIn: parent
                                text: "⚡"
                                font.pixelSize: 14
                            }
                        }

                        ColumnLayout {
                            spacing: 2
                            Text {
                                text: qsTr("Batería")
                                color: "white"
                                font.bold: true
                                font.pixelSize: 12
                            }
                            Text {
                                text: (typeof hardwareCtrl !== "undefined") ? (hardwareCtrl.batteryPercentage + "%" + (hardwareCtrl.isCharging ? " (Cargando)" : "")) : "100%"
                                color: "#EBEBF5"
                                font.pixelSize: 10
                            }
                        }
                    }
                }
            }

            // Slider de Pantalla (Brillo)
            Rectangle {
                Layout.fillWidth: true
                height: 52
                radius: 12
                color: "#2C2C2E"

                ColumnLayout {
                    anchors.fill: parent
                    anchors.margins: 8
                    spacing: 4

                    Text {
                        text: qsTr("Pantalla")
                        color: "white"
                        font.pixelSize: 11
                        font.bold: true
                    }

                    RowLayout {
                        Layout.fillWidth: true
                        spacing: 8

                        Text { text: "🔆"; font.pixelSize: 12; color: "white" }

                        Slider {
                            id: brightnessSlider
                            Layout.fillWidth: true
                            from: 5
                            to: 100
                            value: typeof hardwareCtrl !== "undefined" ? hardwareCtrl.brightness : 80
                            onMoved: if (typeof hardwareCtrl !== "undefined") hardwareCtrl.brightness = value
                        }
                    }
                }
            }

            // Slider de Sonido (Volumen)
            Rectangle {
                Layout.fillWidth: true
                height: 52
                radius: 12
                color: "#2C2C2E"

                ColumnLayout {
                    anchors.fill: parent
                    anchors.margins: 8
                    spacing: 4

                    Text {
                        text: qsTr("Sonido")
                        color: "white"
                        font.pixelSize: 11
                        font.bold: true
                    }

                    RowLayout {
                        Layout.fillWidth: true
                        spacing: 8

                        Text {
                            text: (typeof hardwareCtrl !== "undefined" && hardwareCtrl.isMuted) ? "🔇" : "🔊"
                            font.pixelSize: 12
                            color: "white"

                            MouseArea {
                                anchors.fill: parent
                                onClicked: if (typeof hardwareCtrl !== "undefined") hardwareCtrl.toggleMute()
                            }
                        }

                        Slider {
                            id: volumeSlider
                            Layout.fillWidth: true
                            from: 0
                            to: 100
                            value: typeof hardwareCtrl !== "undefined" ? hardwareCtrl.volume : 75
                            onMoved: if (typeof hardwareCtrl !== "undefined") hardwareCtrl.volume = value
                        }
                    }
                }
            }

            // Widget de Reproducción Multimedia
            Rectangle {
                Layout.fillWidth: true
                height: 56
                radius: 12
                color: "#2C2C2E"

                RowLayout {
                    anchors.fill: parent
                    anchors.margins: 10
                    spacing: 10

                    Rectangle {
                        width: 36
                        height: 36
                        radius: 8
                        color: "#FF2D55"
                        Text {
                            anchors.centerIn: parent
                            text: "🎵"
                            font.pixelSize: 16
                        }
                    }

                    ColumnLayout {
                        Layout.fillWidth: true
                        spacing: 2
                        Text {
                            text: typeof hardwareCtrl !== "undefined" ? hardwareCtrl.mediaTitle : "Música"
                            color: "white"
                            font.bold: true
                            font.pixelSize: 11
                            elide: Text.ElideRight
                        }
                        Text {
                            text: typeof hardwareCtrl !== "undefined" ? hardwareCtrl.mediaArtist : "Quartz Audio"
                            color: "#8E8E93"
                            font.pixelSize: 10
                            elide: Text.ElideRight
                        }
                    }

                    // Controles multimedia
                    RowLayout {
                        spacing: 6

                        Text {
                            text: "⏮"
                            color: "white"
                            font.pixelSize: 14
                            MouseArea {
                                anchors.fill: parent
                                onClicked: if (typeof hardwareCtrl !== "undefined") hardwareCtrl.mediaPrevious()
                            }
                        }

                        Text {
                            text: (typeof hardwareCtrl !== "undefined" && hardwareCtrl.isMediaPlaying) ? "⏸" : "▶"
                            color: "white"
                            font.pixelSize: 16
                            MouseArea {
                                anchors.fill: parent
                                onClicked: if (typeof hardwareCtrl !== "undefined") hardwareCtrl.mediaPlayPause()
                            }
                        }

                        Text {
                            text: "⏭"
                            color: "white"
                            font.pixelSize: 14
                            MouseArea {
                                anchors.fill: parent
                                onClicked: if (typeof hardwareCtrl !== "undefined") hardwareCtrl.mediaNext()
                            }
                        }
                    }
                }
            }
        }
    }
}
</file>

<file path="src/shell/qml/ForceQuitModal.qml">
import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15

Window {
    id: forceQuitWin
    visible: m_visible
    width: 380
    height: 340
    color: "transparent"
    flags: Qt.Dialog | Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint

    x: (Screen.width - width) / 2
    y: (Screen.height - height) / 2

    property bool m_visible: false
    property int selectedIndex: -1

    function showDialog() {
        selectedIndex = -1;
        m_visible = true;
    }

    function hideDialog() {
        m_visible = false;
    }

    property var userApps: {
        var list = [];
        if (typeof dockCtrl !== "undefined") {
            for (var i = 0; i < dockCtrl.apps.length; ++i) {
                var app = dockCtrl.apps[i];
                // Excluir componentes protegidos del sistema
                if (app.running && !app.isSeparator && app.cmd !== "quartz-session" && app.cmd !== "kwin_wayland" && app.cmd !== "quartz-shell") {
                    list.push(app);
                }
            }
        }
        return list;
    }

    Rectangle {
        anchors.fill: parent
        radius: 16
        color: "#F6F6F6"
        border.color: "#D1D1D6"
        border.width: 1

        ColumnLayout {
            anchors.fill: parent
            anchors.margins: 18
            spacing: 12

            Text {
                text: qsTr("Forzar salida de las aplicaciones")
                font.bold: true
                font.pixelSize: 15
                color: "#1C1C1E"
            }

            Text {
                text: qsTr("Si una aplicación no responde durante un tiempo, selecciónala y haz clic en Forzar salida.")
                font.pixelSize: 11
                color: "#8E8E93"
                wrapMode: Text.WordWrap
                Layout.fillWidth: true
            }

            // Lista con borde
            Rectangle {
                Layout.fillWidth: true
                Layout.fillHeight: true
                radius: 8
                color: "#FFFFFF"
                border.color: "#E5E5EA"

                ListView {
                    id: appList
                    anchors.fill: parent
                    anchors.margins: 4
                    clip: true
                    model: userApps

                    delegate: Rectangle {
                        width: appList.width
                        height: 32
                        radius: 6
                        color: index === selectedIndex ? "#007AFF" : "transparent"

                        RowLayout {
                            anchors.fill: parent
                            anchors.leftMargin: 8
                            anchors.rightMargin: 8
                            spacing: 8

                            Rectangle {
                                width: 18
                                height: 18
                                radius: 4
                                color: "#34C759"
                                Text {
                                    anchors.centerIn: parent
                                    text: modelData.name ? modelData.name.charAt(0).toUpperCase() : "A"
                                    color: "white"
                                    font.bold: true
                                    font.pixelSize: 10
                                }
                            }

                            Text {
                                text: modelData.name
                                color: index === selectedIndex ? "#FFFFFF" : "#1C1C1E"
                                font.pixelSize: 12
                                Layout.fillWidth: true
                            }
                        }

                        MouseArea {
                            anchors.fill: parent
                            onClicked: selectedIndex = index
                        }
                    }
                }
            }

            RowLayout {
                Layout.fillWidth: true
                Item { Layout.fillWidth: true }

                Button {
                    text: qsTr("Cancelar")
                    onClicked: hideDialog()
                }

                Button {
                    text: qsTr("Forzar salida")
                    enabled: selectedIndex >= 0 && selectedIndex < userApps.length
                    onClicked: {
                        if (selectedIndex >= 0 && selectedIndex < userApps.length) {
                            var target = userApps[selectedIndex];
                            if (typeof dockCtrl !== "undefined") {
                                dockCtrl.forceQuitApp(target.cmd);
                            }
                            hideDialog();
                        }
                    }
                }
            }
        }
    }
}
</file>

<file path="src/shell/qml/LaunchpadOverlay.qml">
import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15
import QtQuick.Window 2.15

Window {
    id: launchpadWin
    title: "Launchpad"
    width: Screen.desktopAvailableWidth > 0 ? Screen.desktopAvailableWidth : 1920
    height: Screen.desktopAvailableHeight > 0 ? Screen.desktopAvailableHeight : 1080
    visible: typeof launchpadCtrl !== "undefined" ? launchpadCtrl.visible : false
    color: "transparent"
    flags: Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint

    // Fondo translúcido oscuro con desenfoque simulado
    Rectangle {
        id: bgOverlay
        anchors.fill: parent
        color: "#B3000000"

        MouseArea {
            anchors.fill: parent
            onClicked: {
                if (typeof launchpadCtrl !== "undefined") {
                    launchpadCtrl.visible = false
                }
            }
        }

        ColumnLayout {
            anchors.fill: parent
            anchors.topMargin: 48
            anchors.bottomMargin: 48
            anchors.leftMargin: 80
            anchors.rightMargin: 80
            spacing: 24

            // 1. Barra de Búsqueda estilo macOS
            Rectangle {
                Layout.alignment: Qt.AlignHCenter
                Layout.preferredWidth: 260
                Layout.preferredHeight: 32
                radius: 8
                color: "#40FFFFFF"
                border.color: "#33FFFFFF"
                border.width: 1

                RowLayout {
                    anchors.fill: parent
                    anchors.leftMargin: 10
                    anchors.rightMargin: 10
                    spacing: 6

                    Text {
                        text: "🔍"
                        font.pixelSize: 12
                        color: "#FFFFFF"
                    }

                    TextField {
                        id: searchBox
                        Layout.fillWidth: true
                        font.pixelSize: 13
                        color: "#FFFFFF"
                        placeholderText: qsTr("Buscar")
                        placeholderTextColor: "#99FFFFFF"
                        background: null
                        focus: launchpadWin.visible
                        text: typeof launchpadCtrl !== "undefined" ? launchpadCtrl.filterText : ""
                        onTextChanged: {
                            if (typeof launchpadCtrl !== "undefined") {
                                launchpadCtrl.filterText = text
                            }
                        }
                        Keys.onEscapePressed: {
                            if (typeof launchpadCtrl !== "undefined") {
                                launchpadCtrl.visible = false
                            }
                        }
                    }

                    Text {
                        text: "✕"
                        font.pixelSize: 11
                        color: "#B3FFFFFF"
                        visible: searchBox.text.length > 0
                        MouseArea {
                            anchors.fill: parent
                            cursorShape: Qt.PointingHandCursor
                            onClicked: searchBox.text = ""
                        }
                    }
                }
            }

            // 2. Cuadrícula de Aplicaciones
            GridView {
                id: appsGrid
                Layout.fillWidth: true
                Layout.fillHeight: true
                cellWidth: 140
                cellHeight: 140
                clip: true
                model: typeof launchpadCtrl !== "undefined" ? launchpadCtrl.apps : []

                delegate: Item {
                    width: appsGrid.cellWidth
                    height: appsGrid.cellHeight

                    Rectangle {
                        id: appCard
                        anchors.fill: parent
                        anchors.margins: 8
                        radius: 14
                        color: hoverArea.containsMouse ? "#26FFFFFF" : "transparent"
                        scale: hoverArea.containsMouse ? 1.05 : 1.0
                        Behavior on scale { NumberAnimation { duration: 120 } }
                        Behavior on color { ColorAnimation { duration: 120 } }

                        ColumnLayout {
                            anchors.centerIn: parent
                            spacing: 8

                            // Icono estilizado
                            Rectangle {
                                Layout.alignment: Qt.AlignHCenter
                                Layout.preferredWidth: 64
                                Layout.preferredHeight: 64
                                radius: 14
                                color: "#2B2B2E"
                                border.color: "#33FFFFFF"
                                border.width: 1

                                Image {
                                    anchors.centerIn: parent
                                    width: 48
                                    height: 48
                                    source: modelData.icon ? ("image://icon/" + modelData.icon) : ""
                                    sourceSize: Qt.size(48, 48)
                                    fillMode: Image.PreserveAspectFit
                                    visible: status === Image.Ready
                                }

                                Text {
                                    anchors.centerIn: parent
                                    text: modelData.name.length > 0 ? modelData.name.substring(0, 1).toUpperCase() : "A"
                                    font.pixelSize: 26
                                    font.bold: true
                                    color: "#FFFFFF"
                                    visible: true
                                }
                            }

                            // Nombre de la App
                            Text {
                                Layout.alignment: Qt.AlignHCenter
                                Layout.maximumWidth: 120
                                text: modelData.name
                                font.pixelSize: 13
                                font.weight: Font.Medium
                                color: "#FFFFFF"
                                elide: Text.ElideRight
                                horizontalAlignment: Text.AlignHCenter
                            }
                        }

                        MouseArea {
                            id: hoverArea
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                if (typeof launchpadCtrl !== "undefined") {
                                    launchpadCtrl.launchApp(modelData.exec)
                                }
                            }
                        }
                    }
                }
            }

            // 3. Indicador de Páginas / Contador de Apps
            RowLayout {
                Layout.alignment: Qt.AlignHCenter
                spacing: 8

                Text {
                    text: qsTr("%1 aplicaciones disponibles").arg(typeof launchpadCtrl !== "undefined" ? launchpadCtrl.apps.length : 0)
                    font.pixelSize: 12
                    color: "#80FFFFFF"
                }
            }
        }
    }
}
</file>

<file path="src/shell/qml/MissionControlOverlay.qml">
import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15
import QtQuick.Window 2.15

Window {
    id: missionControlWin
    title: "Mission Control"
    width: Screen.desktopAvailableWidth > 0 ? Screen.desktopAvailableWidth : 1920
    height: Screen.desktopAvailableHeight > 0 ? Screen.desktopAvailableHeight : 1080
    visible: typeof missionControlCtrl !== "undefined" ? missionControlCtrl.active : false
    color: "transparent"
    flags: Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint

    Rectangle {
        id: bgOverlay
        anchors.fill: parent
        color: "#99000000"

        MouseArea {
            anchors.fill: parent
            onClicked: {
                if (typeof missionControlCtrl !== "undefined") {
                    missionControlCtrl.active = false
                }
            }
        }

        ColumnLayout {
            anchors.fill: parent
            anchors.margins: 24
            spacing: 20

            // 1. Barra de Spaces (Escritorios Virtuales) superior
            Rectangle {
                Layout.alignment: Qt.AlignHCenter
                Layout.preferredHeight: 110
                Layout.preferredWidth: Math.min(missionControlWin.width - 48, spacesRow.implicitWidth + 40)
                radius: 16
                color: "#40000000"
                border.color: "#33FFFFFF"
                border.width: 1

                RowLayout {
                    id: spacesRow
                    anchors.centerIn: parent
                    spacing: 16

                    Repeater {
                        model: typeof missionControlCtrl !== "undefined" ? missionControlCtrl.spaces : []

                        delegate: Rectangle {
                            id: spaceThumb
                            Layout.preferredWidth: 130
                            Layout.preferredHeight: 84
                            radius: 10
                            color: modelData.active ? "#33007AFF" : "#26FFFFFF"
                            border.color: modelData.active ? "#007AFF" : "#33FFFFFF"
                            border.width: modelData.active ? 2 : 1
                            scale: spaceHover.containsMouse ? 1.05 : 1.0
                            Behavior on scale { NumberAnimation { duration: 120 } }

                            ColumnLayout {
                                anchors.centerIn: parent
                                spacing: 4

                                Text {
                                    Layout.alignment: Qt.AlignHCenter
                                    text: "🖥️"
                                    font.pixelSize: 22
                                }

                                Text {
                                    Layout.alignment: Qt.AlignHCenter
                                    text: modelData.name
                                    font.pixelSize: 11
                                    font.weight: modelData.active ? Font.Bold : Font.Normal
                                    color: "#FFFFFF"
                                }
                            }

                            // Botón de cerrar espacio si hay más de 1
                            Rectangle {
                                anchors.top: parent.top
                                anchors.right: parent.right
                                anchors.margins: 4
                                width: 16
                                height: 16
                                radius: 8
                                color: "#80FF3B30"
                                visible: spaceHover.containsMouse && (typeof missionControlCtrl !== "undefined" && missionControlCtrl.spaces.length > 1)

                                Text {
                                    anchors.centerIn: parent
                                    text: "✕"
                                    font.pixelSize: 9
                                    color: "#FFFFFF"
                                }

                                MouseArea {
                                    anchors.fill: parent
                                    onClicked: {
                                        if (typeof missionControlCtrl !== "undefined") {
                                            missionControlCtrl.removeSpace(index)
                                        }
                                    }
                                }
                            }

                            MouseArea {
                                id: spaceHover
                                anchors.fill: parent
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onClicked: {
                                    if (typeof missionControlCtrl !== "undefined") {
                                        missionControlCtrl.switchToSpace(index)
                                    }
                                }
                            }
                        }
                    }

                    // Botón para agregar un nuevo Space (+)
                    Rectangle {
                        Layout.preferredWidth: 44
                        Layout.preferredHeight: 84
                        radius: 10
                        color: addHover.containsMouse ? "#40FFFFFF" : "#20FFFFFF"
                        border.color: "#33FFFFFF"
                        border.width: 1

                        Text {
                            anchors.centerIn: parent
                            text: "+"
                            font.pixelSize: 24
                            font.weight: Font.Light
                            color: "#FFFFFF"
                        }

                        MouseArea {
                            id: addHover
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                if (typeof missionControlCtrl !== "undefined") {
                                    missionControlCtrl.addSpace()
                                }
                            }
                        }
                    }
                }
            }

            // 2. Área principal de ventanas (Rejilla de Mission Control)
            Item {
                Layout.fillWidth: true
                Layout.fillHeight: true

                // Si no hay ventanas activas registradas en la vista
                ColumnLayout {
                    anchors.centerIn: parent
                    spacing: 12
                    visible: typeof missionControlCtrl === "undefined" || missionControlCtrl.windows.length === 0

                    Text {
                        Layout.alignment: Qt.AlignHCenter
                        text: "🪟"
                        font.pixelSize: 48
                        opacity: 0.6
                    }

                    Text {
                        Layout.alignment: Qt.AlignHCenter
                        text: qsTr("Mission Control activo")
                        font.pixelSize: 18
                        font.bold: true
                        color: "#E0FFFFFF"
                    }

                    Text {
                        Layout.alignment: Qt.AlignHCenter
                        text: qsTr("Pulsa Super+Up o haz clic en cualquier lugar para volver")
                        font.pixelSize: 13
                        color: "#99FFFFFF"
                    }
                }
            }
        }
    }
}
</file>

<file path="src/shell/qml/NotificationBanner.qml">
import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15

Window {
    id: bannerWindow
    visible: notificationModel ? notificationModel.activeBanners.length > 0 : false
    width: 360
    height: Math.min(600, bannerCol.implicitHeight + 20)
    color: "transparent"
    flags: Qt.FramelessWindowHint | Qt.WindowStaysOnTopHint | Qt.Tool

    // Posición superior derecha
    x: Screen.width - width - 20
    y: 34

    Column {
        id: bannerCol
        width: parent.width
        spacing: 10

        Repeater {
            model: notificationModel ? notificationModel.activeBanners : []

            delegate: Rectangle {
                id: card
                width: 360
                height: contentLayout.implicitHeight + 24
                radius: 16
                color: "#E62C2C2E" // Frosted glass oscuro macOS
                border.color: "#33FFFFFF"
                border.width: 1

                ColumnLayout {
                    id: contentLayout
                    anchors.fill: parent
                    anchors.margins: 12
                    spacing: 6

                    // Cabecera: Icono, Nombre de app, tiempo, botón cerrar
                    RowLayout {
                        Layout.fillWidth: true
                        spacing: 8

                        Rectangle {
                            width: 20
                            height: 20
                            radius: 4

                            color: "#007AFF"
                            Text {
                                anchors.centerIn: parent
                                text: "P"
                                color: "white"
                                font.bold: true
                                font.pixelSize: 16
                            }
                        }

                        ColumnLayout {
                            spacing: 2
                            Text {
                                text: qsTr("Pedro")
                                font.bold: true
                                font.pixelSize: 13
                                color: "#1C1C1E"
                            }
                            Text {
                                text: qsTr("Cuenta Local")
                                font.pixelSize: 11
                                color: "#8E8E93"
                            }
                        }
                    }
                }

                // Lista de módulos de configuración
                ListView {
                    id: panesListView
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    model: settingsModel
                    clip: true
                    spacing: 2

                    delegate: Rectangle {
                        width: panesListView.width
                        height: 34
                        radius: 6
                        color: ListView.isCurrentItem ? "#007AFF" : (mouseArea.containsMouse ? "#E1E1E6" : "transparent")

                        RowLayout {
                            anchors.fill: parent
                            anchors.leftMargin: 8
                            anchors.rightMargin: 8
                            spacing: 8

                            Rectangle {
                                width: 20
                                height: 20
                                radius: 4
                                color: "#8E8E93"
                            }

                            Text {
                                Layout.fillWidth: true
                                text: model.title
                                color: ListView.isCurrentItem ? "#FFFFFF" : "#1C1C1E"
                                font.pixelSize: 13
                            }
                        }

                        MouseArea {
                            id: mouseArea
                            anchors.fill: parent
                            hoverEnabled: true
                            onClicked: panesListView.currentIndex = index
                        }
                    }
                }
            }
        }

        // Separador vertical
        Rectangle {
            Layout.preferredWidth: 1
            Layout.fillHeight: true
            color: "#D1D1D6"
        }

        // Panel de contenido derecho (Carga dinámica de los 18 paneles macOS)
        ScrollView {
            Layout.fillWidth: true
            Layout.fillHeight: true
            clip: true

            ColumnLayout {
                width: parent.width - 48
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 16

                Item { height: 12 }

                Loader {
                    id: paneLoader
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    source: {
                        if (!panesListView.currentItem || !panesListView.model) return "qrc:/qml/panes/GeneralPane.qml"
                        var path = panesListView.model.data(panesListView.model.index(panesListView.currentIndex, 0), 261)
                        return path || "qrc:/qml/panes/GeneralPane.qml"
                    }
                }

                Item { height: 20 }
            }
        }
    }
}

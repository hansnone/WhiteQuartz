NoDisplay=false
"#;
        let entry = DesktopAppEntry::parse_string(content).expect("Debe parsear Desktop Entry");
        assert_eq!(entry.name, "Text Editor");
        assert_eq!(entry.generic_name, "Editor de Texto");
